# MetaApi credentials (get from https://app.metaapi.cloud)
METAAPI_TOKEN=your_metaapi_jwt_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_uuid_here

# Telegram (used by phenex-listener)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=string_session_after_first_login

# Scanner config
SCAN_SYMBOL=XAUUSD
SCAN_INTERVAL_MS=30000
